[mysqld]
# heavy-weather-db-schema.md に合わせる。8.4 の既定と同じ値だが、
# 既定に依存せず明示することで IaC / CI 側と突き合わせられるようにしている。
character-set-server = utf8mb4
collation-server     = utf8mb4_0900_ai_ci

# DATETIME(6) を UTC 固定で読み書きする規約のため、サーバのタイムゾーンも UTC に揃える。
# Lambda の実行環境は既定で UTC であり、ローカルだけ JST だと時刻の差異が隠れる。
default-time-zone = '+00:00'

# Lambda 凍結中に切断された接続を掴む問題を再現・検証できるよう、既定の 28800 秒より
# 短く明示する。アプリ側の SetConnMaxIdleTime はこの値より短く設定すること。
wait_timeout      = 600
interactive_timeout = 600

[client]
default-character-set = utf8mb4
