# cp .env.example .env して使う。.env は .gitignore 済み。

# --- db コンテナ（mysql イメージの初期化に使われる） ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=heavy_weather
MYSQL_USER=heavy_weather
MYSQL_PASSWORD=heavy_weather

# ホストから GUI クライアント等で繋ぐときの公開ポート。
# ホストで別の MySQL が 3306 を使っている場合はここを変える。
DB_PUBLISHED_PORT=3306

# --- app コンテナ（アプリケーションが読む接続情報） ---
# ホスト名は compose のサービス名。app からは db:3306 で解決される。
DB_HOST=db
DB_PORT=3306
DB_NAME=heavy_weather
DB_USER=heavy_weather
DB_PASSWORD=heavy_weather
